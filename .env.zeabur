# Zeabur 環境變量配置模板
#
# 使用說明：
# 1. 複製此文件內容
# 2. 在 Zeabur Dashboard → 服務 → Variables 中粘貼
# 3. 替換所有 <your-xxx> 為實際值
# 4. 保存並重啟服務

# ==================== 必需配置 ====================

# OpenAI API 配置
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# 數據庫配置（Zeabur PostgreSQL 自動注入）
# 組合成完整的 DATABASE_URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# 或使用外部數據庫（二選一）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 應用環境
ENVIRONMENT=production
DEBUG=false

# ==================== OCR 配置 ====================

# OCR 引擎設置
OCR_USE_GPU=false
OCR_LANG=ch
OCR_DET_DB_THRESH=0.3
OCR_DET_DB_BOX_THRESH=0.5
OCR_REC_BATCH_NUM=6

# ==================== 質量控制 ====================

# 質量閾值（1-5）
QUALITY_THRESHOLD=4.0

# 最大迭代次數
MAX_ITERATIONS=3

# 是否啟用自動審查
AUTO_REVIEW=true

# ==================== 數據庫配置 ====================

# 連接池設置
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# 是否顯示 SQL 語句（調試用）
DATABASE_ECHO=false

# ==================== API 配置 ====================

# API 服務器
API_HOST=0.0.0.0
API_PORT=${PORT:-8000}

# 工作進程數（根據 CPU 調整）
API_WORKERS=2

# 請求超時（秒）
API_TIMEOUT=60

# 允許的來源（CORS）
API_ALLOWED_ORIGINS=*

# ==================== 日誌配置 ====================

# 日誌級別：debug, info, warning, error, critical
LOG_LEVEL=info

# 日誌文件路徑
LOG_FILE=/app/logs/agenticmath.log

# 日誌格式：json 或 text
LOG_FORMAT=json

# 日誌輪轉大小（MB）
LOG_MAX_SIZE=100

# 保留日誌文件數量
LOG_BACKUP_COUNT=5

# ==================== 文件上傳配置 ====================

# 上傳目錄
UPLOAD_DIR=/app/uploads

# 最大文件大小（MB）
MAX_FILE_SIZE=10

# 允許的文件類型
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# ==================== 性能優化 ====================

# 是否啟用緩存
ENABLE_CACHE=true

# 緩存過期時間（秒）
CACHE_TTL=3600

# 最大並發請求數
MAX_CONCURRENT_REQUESTS=10

# ==================== 安全配置 ====================

# API 密鑰（可選，用於保護 API）
# API_SECRET_KEY=<your-secret-key>

# 是否啟用速率限制
ENABLE_RATE_LIMIT=true

# 速率限制（請求/分鐘）
RATE_LIMIT=100

# ==================== 監控配置 ====================

# 是否啟用監控
ENABLE_MONITORING=true

# Sentry DSN（可選，用於錯誤追蹤）
# SENTRY_DSN=<your-sentry-dsn>

# ==================== 功能開關 ====================

# 是否啟用 OCR 功能
ENABLE_OCR=true

# 是否啟用題目改寫
ENABLE_REPHRASE=true

# 是否啟用解題功能
ENABLE_SOLVER=true

# 是否啟用審查功能
ENABLE_REVIEW=true
